---
import Layout from "../layouts/Layout.astro";
import LogoAnimate from "@components/logo-animate.astro";
import ExperienceItem from "@components/JobHistoryItem.astro";
import ProjectCard from "@components/card/ProjectCardHome.astro";
import { getCollection } from "astro:content";
const projects = await getCollection('project');
---

<Layout>
    <div class="about-wrapper">
        <div class="bio">
            <p>Hi I'm</p>
            <h1>Max</h1>
            <h1>Spooner</h1>
        </div>
        <LogoAnimate />
    </div>
    <div class="about-me">
        <p>I am a <span class="date-output"></span> Year old Software Engineer from London, UK. I have experience building full-stack web applications and utilising cloud systems to improve scalability and reliability. I am also passionate about computer graphics and performance optimisations.</p>
    </div>

    <div class="content-sections">
        <section class="experience">
            <h2>Experience</h2>

            <ExperienceItem
                title="Junior Software Engineer"
                company="ID Business Solutions"
                dates="2024 – 2025"
                description={
                    [
                        "Reduced internal deployment time of data science web application from 25 minutes to 5 minutes.",
                        "Helped overhaul cloud architecture of legacy service to improve data integrity enabling application to be used by more clients.",
                        "Helped deliver high-priority project from proof of concept to release, using IoT technology to enhance data integration from clients' on-premises devices."
                    ]
                }
            />
            <ExperienceItem
                title="Bachelors In Computer Science"
                company="University of Bath"
                dates="2022 – 2026"
                description={["Ranked among the top 10 students in first year with an average grade of 86%."]}
            />
            <ExperienceItem
                    title="LawTech Intern"
                    company="Macfarlanes"
                    dates="2022 – 2022"
                    description={["Integrated React into existing vanilla JavaScript webpages, improving UI functionality and maintainability."]}
            />
            <ExperienceItem
                title="IT Technician"
                company="St. Andrew's School Woking"
                dates="2021 – 2022"
                description={["Overhauled legacy server infrastructure, supporting over 300 students and 60 staff members to ensure reliable daily operations."]}
            />
        </section>

        <section class="projects">
            <h2>Projects</h2>
            <div class="projects-grid">
                {projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0,3).map((project) => (
                    <ProjectCard
                            title={project.data.title}
                            description={project.data.description}
                            href={`/projects/${project.id}/`}
                            image={project.data.image}
                    />
                ))}
            </div>
        </section>
    </div>
</Layout>

<style>
    h1 {
        margin: 0;
        line-height: 80%;
    }

    p {
        margin: 0;
        color: gray;
    }

    .about-me p{
        margin: 5rem;
        color: var(--text);
        font-size: 3vh;
    }

    .bio {
        font-size: 4vh;
        height: 700px;
        display: flex;
        flex-direction: column;
        align-items: start;
        justify-content: center;
    }

    .about-wrapper {
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
    }

    .content-sections {
        margin: 0 auto;
        font-size: 2.5vh;
    }

    .content-sections section {
        margin: 5rem;
    }

    .content-sections h2 {
        color: var(--accent);
        margin-bottom: 1rem;
        font-size: 3vh;
        border-bottom: 2px solid #ccc;
        padding-bottom: 0.5rem;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }

        .content-sections section {
            margin: 5%;
        }

        .about-me p {
            margin: 0px;
        }
    }

</style>

<script type="text/javascript" is:inline>
  const now = new Date();
  const bd = Date.parse("12/22/2002");
  const diff = Math.floor((now - bd) / (1000*60*60*24*365.25));
  document.getElementsByClassName('date-output')[0].textContent = diff;
</script>
