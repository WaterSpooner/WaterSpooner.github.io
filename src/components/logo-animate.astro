<style>
    svg {
        width: 300px;
        height: auto;
    }

    path {
        fill: color-mix(in srgb, var(--background) 80%, var(--accent));
        fill-opacity: 0;
        stroke: color-mix(in srgb, var(--background) 80%, var(--accent));
        stroke-width: 0.5;
        stroke-opacity: 1;
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: draw 7s ease forwards, fadeFill 1s ease forwards;
        animation-delay: 0.2s, 1.5s;
    }

    @keyframes draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @keyframes fadeFill {
        to {
            fill-opacity: 1;
        }
    }
</style>

