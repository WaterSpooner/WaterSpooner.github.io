---
// src/components/ProjectCard.astro
const { title, description, image, href } = Astro.props;
---

<a class="project-card" href={href}>
    <img src={image.src} alt={title} />
    <div class="overlay">
        <div class="text">
            <h3>{title}</h3>
            <p>{description}</p>
        </div>
    </div>
</a>

<style>
    a {
        text-decoration: none;
    }

    .project-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius);
        aspect-ratio: 4 / 3;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .project-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: var(--radius);
        transition: transform 0.3s ease;
    }

    .project-card:hover img {
        transform: scale(1.05);
    }

    .overlay {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: var(--space);
        transition: opacity 0.5s ease;
        text-align: center;
        background-color: rgba(20, 20, 25, 0.75);
        opacity: 0;
    }

    .project-card:hover .overlay {
        opacity: 1;
    }

    /* Always show overlay on small screens and reposition text */
    @media (max-width: 768px) {
        .overlay {
            opacity: 1 !important;
            justify-content: flex-start;
            align-items: flex-end;
            background-color: rgba(20, 20, 20, 0.6);
            padding: 0.75rem;
            text-align: start;
        }

        .overlay .text {
            padding: 0.5rem 0.75rem;
            border-radius: var(--radius);
        }

        .overlay h3,
        .overlay p {
            font-size: 0.9rem;
            margin: 0;
        }

        .overlay h3 {
            color: #A8AACCFF;
        }

        .overlay p {
            color: #E6E6EBFF;
        }
    }

    .overlay h3 {
        color: #9293c8;
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
    }

    .overlay p {
        color: white;
        font-size: 1rem;
    }
</style>
