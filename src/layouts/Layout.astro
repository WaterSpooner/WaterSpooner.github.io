---
import "@styles/global.css";
import Navbar from '@components/structure/Navbar.astro';
import Footer from "@components/structure/Footer.astro";
import Head from '@components/structure/Head.astro';

const props = Astro.props;
const {
  title = "Max Spooner",
  description = "About Me",
} = props;
---
<!DOCTYPE html>
<html lang="en" transition:persist>
  <Head title={title} description={description} {...props} />
  <body class="layout">
    <Navbar />
    <main class="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    -webkit-tap-highlight-color: rgba(0,0,0,0);
    background: var(--background);
    color: var(--text);
    transition: background-color 0.5s ease;
    width: 100%;
  }

  .content {
    width: 80%;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .content {
      width: 95%;
    }
  }


</style>